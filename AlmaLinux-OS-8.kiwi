<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="7.4" name="AlmaLinux">
	<description type="system">
		<author>AlmaLinux OS Contributors</author>
		<contact>devel@lists.almalinux.org</contact>
		<specification>AlmaLinux OS 8</specification>
	</description>
	<preferences>
		<version>8</version>
		<packagemanager>dnf4</packagemanager>
		<locale>en_US</locale>
		<keytable>us</keytable>
		<timezone>Etc/UTC</timezone>
		<rpm-check-signatures>true</rpm-check-signatures>
		<release-version>8</release-version>
	</preferences>
	<include from="this://./repositories/core-release-8.xml"/>
	<include from="this://./components/boot.xml"/>
	<include from="this://./components/users.xml"/>
	<include from="this://./platforms/cloud.xml"/>
	<packages type="image" patternType="onlyRequired">
		<namedCollection name="core"/>
		<package name="linux-firmware"/>
		<ignore name="nano"/>
		<ignore name="yum-utils"/>
	</packages>
	<packages type="bootstrap">
		<package name="basesystem"/>
		<package name="almalinux-release"/>
		<package name="filesystem"/>
	</packages>
</image>
